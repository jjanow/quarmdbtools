#!/usr/bin/env python3
"""Project Quarm database tools. Run with no arguments to open the front end; ./quarm -h lists the tools."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from quarmtools.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
